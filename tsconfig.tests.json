{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "jsx": "react-jsx",
    "rootDir": ".",
    "plugins": []
  },
  "include": ["lib/*.test.ts", "components/*.test.tsx"],
  "exclude": ["node_modules"]
}
